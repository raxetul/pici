{
  "name": "pici",
  "version": "1.0.0",
  "description": "Easy to use PostgreSQL dump and restore management tool",
  "bin": {
    "pici": "./bin/run",
    "bcrypt-pass": "./bcrypt-pass.js"
  },
  "directories": {
    "lib": "src",
    "bin": "bin"
  },
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/raxetul/pici.git"
  },
  "scripts": {
    "build": "tsup-node",
    "build:watch": "tsup-node --watch",
    "clean": "rimraf dist",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "compile": "tsc",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "ts-node -r tsconfig-paths/register ./bin/run.ts",
    "start:node": "node ./bin/run",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "keywords": [
    "typescript",
    "starter",
    "cli",
    "bootstrap"
  ],
  "author": "Andrey Kucherenko <kucherenko.andrey@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "30.2.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@tsconfig/node20": "20.1.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/prompts": "2.4.9",
    "@types/signale": "1.4.7",
    "@types/yargs": "17.0.35",
    "autoprefixer": "10.4.22",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "prettier": "^3.7.3",
    "rimraf": "6.1.2",
    "semantic-release": "25.0.2",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "consola": "3.4.2",
    "dotenv": "17.2.3",
    "giget": "2.0.0",
    "open": "11.0.0",
    "picocolors": "1.1.1",
    "yargs": "18.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
